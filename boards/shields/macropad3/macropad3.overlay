#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;  // [我漏咗呢行] 綁定地圖
    };

    // [我漏咗呢個區塊] 呢度就係話畀大腦知，有 3 個掣排成一線
    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <3>;
        rows = <1>;
        map = <
            RC(0,0) RC(0,1) RC(0,2)
        >;
    };

    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-direct";
        label = "KSCAN";
        input-gpios
            = <&pro_micro 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // 017孔
            , <&pro_micro 3 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // 020孔
            , <&pro_micro 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // 022孔
            ;
    };
};