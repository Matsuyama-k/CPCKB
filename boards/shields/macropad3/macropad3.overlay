#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <3>;
        rows = <1>;
        map = <
            RC(0,0) RC(0,1) RC(0,2)
        >;
    };

    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-direct";
        label = "KSCAN";
        input-gpios
            = <&gpio0 17 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // 繞過翻譯，直指 017 孔
            , <&gpio0 20 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // 繞過翻譯，直指 020 孔
            , <&gpio0 22 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // 繞過翻譯，直指 022 孔
            ;
    };
};