#include <dt-bindings/zmk/matrix_transform.h>

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,matrix-transform = &default_transform;
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <3>;
        rows = <1>;
        map = <
            RC(0,0) RC(0,1) RC(0,2)
        >;
    };

    kscan0: kscan_0 {
        compatible = "zmk,kscan-gpio-direct";
        label = "KSCAN";
        input-gpios
            = <&xiao_d 0 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // 對應 XIAO 板上 D0 孔
            , <&xiao_d 1 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // 對應 XIAO 板上 D1 孔
            , <&xiao_d 2 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)> // 對應 XIAO 板上 D2 孔
            ;
    };
};