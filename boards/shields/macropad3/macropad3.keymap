#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/backlight.h>

/ {
    behaviors {
        // 按鍵閃紅燈巨集 (按下亮燈 50ms 後熄滅並輸出按鍵)
        kp_led: kp_led {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            wait-ms = <0>;
            tap-ms = <50>;
            bindings
                = <&bl BL_ON>
                , <&macro_param_1to1>
                , <&kp MACRO_PLACEHOLDER>
                , <&bl BL_OFF>;
        };
    };

    combos {
        compatible = "zmk,combos";
        
        // D0 + D1 -> 切換 Windows / Mac 模式
        combo_tog_mac {
            timeout-ms = <100>;
            key-positions = <0 1>;
            bindings = <&tog 1>;
        };

        // D1 + D2 -> 清空藍牙配對記錄
        combo_bt_clear {
            timeout-ms = <100>;
            key-positions = <1 2>;
            bindings = <&bt BT_CLR_ALL>;
        };

        // D0 + D2 -> 強制切換 USB / 藍牙 模式
        combo_out_toggle {
            timeout-ms = <100>;
            key-positions = <0 2>;
            bindings = <&out OUT_TOG>;
        };

        // 🌟【免拆殼刷機】：同時按下 D0 + D1 + D2 -> 自動進入 Bootloader 刷機模式
        combo_bootloader {
            timeout-ms = <100>;
            key-positions = <0 1 2>;
            bindings = <&bootloader>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // Layer 0: Windows 模式 (預設)
        win_layer {
            bindings = <
                &kp_led LC(V)       // D0: 貼上 (Ctrl + V)
                &kp_led LC(C)       // D1: 複製 (Ctrl + C)
                &kp_led LG(LS(S))   // D2: Windows 區域截圖 (Win + Shift + S)
                &kp_led ESC         // D3: ESC 鍵
            >;
        };

        // Layer 1: Mac 模式
        mac_layer {
            bindings = <
                &kp_led LG(V)       // D0: 貼上 (Cmd + V)
                &kp_led LG(C)       // D1: 複製 (Cmd + C)
                &kp_led LG(LS(4))   // D2: Mac 區域截圖 (Cmd + Shift + 4)
                &kp_led ESC         // D3: ESC 鍵
            >;
        };
    };
};