#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/backlight.h>

/ {
    behaviors {
        // 一般按鍵閃燈巨集 (Ctrl+C, Ctrl+V, 截圖)
        kp_led: kp_led {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            wait-ms = <0>;
            tap-ms = <50>;
            bindings
                = <&bl BL_ON>
                , <&macro_param_1to1>
                , <&kp MACRO_PLACEHOLDER>
                , <&bl BL_OFF>;
        };

        // 🌟【方案 A：Windows 專用 Alt+Tab 巨集】加長延遲確保 Windows 切換成功
        alt_tab_win: alt_tab_win {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <50>;
            bindings
                = <&bl BL_ON>
                , <&macro_press &kp LALT>
                , <&macro_tap &kp TAB>
                , <&macro_release &kp LALT>
                , <&bl BL_OFF>;
        };

        // 🌟【Mac 專用 Cmd+Tab 巨集】
        cmd_tab_mac: cmd_tab_mac {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <50>;
            bindings
                = <&bl BL_ON>
                , <&macro_press &kp LGUI>
                , <&macro_tap &kp TAB>
                , <&macro_release &kp LGUI>
                , <&bl BL_OFF>;
        };
    };

    combos {
        compatible = "zmk,combos";
        
        // D0 + D1 -> 切換 Windows / Mac 模式
        combo_tog_mac {
            timeout-ms = <100>;
            key-positions = <0 1>;
            bindings = <&tog 1>;
        };

        // D1 + D2 -> 清空藍牙配對記錄
        combo_bt_clear {
            timeout-ms = <100>;
            key-positions = <1 2>;
            bindings = <&bt BT_CLR_ALL>;
        };

        // D0 + D2 -> 強制切換 USB / 藍牙 模式
        combo_out_toggle {
            timeout-ms = <100>;
            key-positions = <0 2>;
            bindings = <&out OUT_TOG>;
        };

        // 🌟【免拆殼刷機】：同時按下 D0 + D1 + D2 -> 自動進入 Bootloader 刷機模式
        combo_bootloader {
            timeout-ms = <100>;
            key-positions = <0 1 2>;
            bindings = <&bootloader>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // Layer 0: Windows 模式 (預設)
        win_layer {
            bindings = <
                &kp_led LC(C)       // D0: 複製 (Ctrl + C)
                &kp_led LC(V)       // D1: 貼上 (Ctrl + V)
                &alt_tab_win        // D2: 切換視窗 (Alt + Tab 修正時序版)
                &kp_led LG(LS(S))   // D3: Windows 區域截圖 (Win + Shift + S)
            >;
        };

        // Layer 1: Mac 模式
        mac_layer {
            bindings = <
                &kp_led LG(C)       // D0: 複製 (Cmd + C)
                &kp_led LG(V)       // D1: 貼上 (Cmd + V)
                &cmd_tab_mac        // D2: 切換視窗 (Cmd + Tab)
                &kp_led LG(LS(4))   // D3: Mac 區域截圖 (Cmd + Shift + 4)
            >;
        };
    };
};